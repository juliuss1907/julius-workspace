# .gitignore

# Telegram session (sensitive)
*.session
*.session-journal

# State files (generated)
.state/

# Logs
logs/
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
venv/
.venv/
env/
ENV/

# Playwright
playwright-report/
test-results/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables (if using .env)
.env
